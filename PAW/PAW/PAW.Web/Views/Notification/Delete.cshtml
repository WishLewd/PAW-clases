@model PAW.Models.DTO.NotificationDTO

<form asp-action="Delete" method="post">
    <div class="modal-header bg-danger text-white">
        <h5 class="modal-title">Delete Notification</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <p class="fs-5">Are you sure you want to delete this notification?</p>
        <div class="alert alert-warning">
            <strong>Notification ID: @Model.Id</strong> (User ID: @Model.UserId)<br />
            <span>@Model.Message</span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>
