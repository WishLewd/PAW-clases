@model PAW.Models.DTO.NotificationDTO
@{
    ViewData["Title"] = "Create Notification";
}

<div class="container mt-4">
    <h2>Create Notification</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="UserId" class="form-label">User ID</label>
                    <input asp-for="UserId" type="number" class="form-control" required />
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Message" class="form-label">Message</label>
                    <textarea asp-for="Message" class="form-control" rows="3" required></textarea>
                    <span asp-validation-for="Message" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsRead" class="form-check-input" type="checkbox" />
                    <label asp-for="IsRead" class="form-check-label">Is Read</label>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </form>
        </div>
    </div>
</div>
