@model PAW.Models.DTO.NotificationDTO

<form asp-action="Create" method="post">
    <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">Add Notification</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="UserId" class="form-label">User ID</label>
            <input asp-for="UserId" type="number" class="form-control" required />
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Message" class="form-label">Message</label>
            <textarea asp-for="Message" class="form-control" rows="3" required></textarea>
            <span asp-validation-for="Message" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsRead" class="form-check-input" type="checkbox" />
            <label asp-for="IsRead" class="form-check-label">Is Read</label>
        </div>
    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-primary">Save</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>
