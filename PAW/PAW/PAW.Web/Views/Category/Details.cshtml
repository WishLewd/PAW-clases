@model PAW.Models.DTO.CategoryDTO

<div class="modal-header bg-info text-white">
    <h5 class="modal-title">Detalle de Categoría: @Model.CategoryName</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <dl class="row mb-0">
        <dt class="col-sm-4">ID Categoría</dt>
        <dd class="col-sm-8">@Model.CategoryId</dd>

        <dt class="col-sm-4">Nombre</dt>
        <dd class="col-sm-8">@Model.CategoryName</dd>

        <dt class="col-sm-4">Descripción</dt>
        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Description) ? "Sin descripción" : Model.Description)</dd>

        <dt class="col-sm-4">Modificado</dt>
        <dd class="col-sm-8">@Model.ModifiedDate.ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>
</div>

<div class="modal-footer">
    <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-warning btn-modal-action">Editar</a>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
</div>
