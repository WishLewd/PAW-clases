@model PAW.Models.DTO.SupplierDTO
@{
    ViewData["Title"] = "Supplier Details";
}

<div class="container mt-4">
    <h2>Supplier Details</h2>
    <hr />
    <div class="card shadow-sm col-md-8">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Supplier ID</dt>
                <dd class="col-sm-8">@Model.SupplierId</dd>

                <dt class="col-sm-4">Supplier Name</dt>
                <dd class="col-sm-8">@Model.SupplierName</dd>

                <dt class="col-sm-4">Contact</dt>
                <dd class="col-sm-8">@Model.ContactName (@Model.ContactTitle)</dd>

                <dt class="col-sm-4">Phone</dt>
                <dd class="col-sm-8">@Model.Phone</dd>

                <dt class="col-sm-4">Address</dt>
                <dd class="col-sm-8">@Model.Address, @Model.City, @Model.Country</dd>

                <dt class="col-sm-4">Modified Date</dt>
                <dd class="col-sm-8">@Model.ModifiedDate.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>
            <a asp-action="Edit" asp-route-id="@Model.SupplierId" class="btn btn-warning">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>
