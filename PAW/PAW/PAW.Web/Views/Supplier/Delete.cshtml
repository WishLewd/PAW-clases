@model PAW.Models.DTO.SupplierDTO
@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="container mt-4">
    <h2 class="text-danger">Delete Supplier</h2>
    <h4>Are you sure you want to delete this supplier?</h4>
    <hr />
    <div class="card shadow-sm col-md-8">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Supplier ID</dt>
                <dd class="col-sm-8">@Model.SupplierId</dd>

                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.SupplierName</dd>

                <dt class="col-sm-4">Phone</dt>
                <dd class="col-sm-8">@Model.Phone</dd>
            </dl>
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="SupplierId" />
                <button type="submit" class="btn btn-danger">Confirm Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
