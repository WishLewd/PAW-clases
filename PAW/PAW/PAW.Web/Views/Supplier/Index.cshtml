@model IEnumerable<PAW.Models.DTO.SupplierDTO>
@{
    ViewData["Title"] = "Suppliers";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Suppliers</h2>
        <a asp-action="Create" class="btn btn-primary btn-modal-action">
            <i class="bi bi-plus-circle"></i> Add Supplier
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Supplier ID</th>
                            <th>Name</th>
                            <th>Contact</th>
                            <th>Phone</th>
                            <th>City / Country</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.SupplierId</td>
                                    <td><strong>@item.SupplierName</strong></td>
                                    <td>@item.ContactName (@item.ContactTitle)</td>
                                    <td>@item.Phone</td>
                                    <td>@item.City, @item.Country</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.SupplierId" class="btn btn-sm btn-warning btn-modal-action">Edit</a>
                                            <a asp-action="Details" asp-route-id="@item.SupplierId" class="btn btn-sm btn-info btn-modal-action">Details</a>
                                            <a asp-action="Delete" asp-route-id="@item.SupplierId" class="btn btn-sm btn-danger btn-modal-action">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">No suppliers found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_Pagination", (PAW.Web.Models.PaginationModel)ViewBag.Pagination)
        </div>
    </div>
</div>
