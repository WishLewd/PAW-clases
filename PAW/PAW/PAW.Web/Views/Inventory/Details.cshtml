@model PAW.Models.DTO.InventoryDTO

<div class="modal-header bg-info text-white">
    <h5 class="modal-title">Inventory Details: ID #@Model.InventoryId</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <dl class="row mb-0">
        <dt class="col-sm-4">Inventory ID</dt>
        <dd class="col-sm-8">@Model.InventoryId</dd>

        <dt class="col-sm-4">Product ID</dt>
        <dd class="col-sm-8">@Model.ProductId</dd>

        <dt class="col-sm-4">Unit Price</dt>
        <dd class="col-sm-8">@Model.UnitPrice?.ToString("C")</dd>

        <dt class="col-sm-4">Units In Stock</dt>
        <dd class="col-sm-8">@Model.UnitsInStock</dd>

        <dt class="col-sm-4">Date Added</dt>
        <dd class="col-sm-8">@Model.DateAdded?.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-4">Last Updated</dt>
        <dd class="col-sm-8">@Model.LastUpdated?.ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>
</div>

<div class="modal-footer">
    <a asp-action="Edit" asp-route-id="@Model.InventoryId" class="btn btn-warning btn-modal-action">Edit</a>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>
