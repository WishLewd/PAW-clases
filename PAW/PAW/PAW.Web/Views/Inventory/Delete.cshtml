@model PAW.Models.DTO.InventoryDTO
@{
    ViewData["Title"] = "Delete Inventory";
}

<div class="container mt-4">
    <h2 class="text-danger">Delete Inventory</h2>
    <h4>Are you sure you want to delete this inventory record?</h4>
    <hr />
    <div class="card shadow-sm col-md-8">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Inventory ID</dt>
                <dd class="col-sm-8">@Model.InventoryId</dd>

                <dt class="col-sm-4">Product ID</dt>
                <dd class="col-sm-8">@Model.ProductId</dd>

                <dt class="col-sm-4">Units In Stock</dt>
                <dd class="col-sm-8">@Model.UnitsInStock</dd>
            </dl>
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="InventoryId" />
                <button type="submit" class="btn btn-danger">Confirm Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
