@model PAW.Models.DTO.InventoryDTO

<form asp-action="Delete" method="post">
    <div class="modal-header bg-danger text-white">
        <h5 class="modal-title">Delete Inventory</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <input type="hidden" asp-for="InventoryId" />
        <p class="fs-5">Are you sure you want to delete this inventory record?</p>
        <div class="alert alert-warning">
            <strong>Inventory ID: @Model.InventoryId</strong><br />
            <span>Product ID: @Model.ProductId | Units: @Model.UnitsInStock | Unit Price: @Model.UnitPrice?.ToString("C")</span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>
