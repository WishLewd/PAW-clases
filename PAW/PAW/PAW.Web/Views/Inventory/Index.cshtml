@model IEnumerable<PAW.Models.DTO.InventoryDTO>
@{
    ViewData["Title"] = "Inventories";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Inventories</h2>
        <a asp-action="Create" class="btn btn-primary btn-modal-action">
            <i class="bi bi-plus-circle"></i> Add Inventory
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Inventory ID</th>
                            <th>Product ID</th>
                            <th>Unit Price</th>
                            <th>Units In Stock</th>
                            <th>Date Added</th>
                            <th>Last Updated</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.InventoryId</td>
                                    <td>@item.ProductId</td>
                                    <td>@item.UnitPrice?.ToString("C")</td>
                                    <td>@item.UnitsInStock</td>
                                    <td>@item.DateAdded?.ToString("yyyy-MM-dd")</td>
                                    <td>@item.LastUpdated?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.InventoryId" class="btn btn-sm btn-warning btn-modal-action">Edit</a>
                                            <a asp-action="Details" asp-route-id="@item.InventoryId" class="btn btn-sm btn-info btn-modal-action">Details</a>
                                            <a asp-action="Delete" asp-route-id="@item.InventoryId" class="btn btn-sm btn-danger btn-modal-action">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center">No inventory records found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_Pagination", (PAW.Web.Models.PaginationModel)ViewBag.Pagination)
        </div>
    </div>
</div>
