@model PAW.Models.DTO.ComponentDTO

<div class="modal-header bg-info text-white">
    <h5 class="modal-title">Component Details: @Model.Name</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Content</dt>
        <dd class="col-sm-9"><pre class="bg-light p-2 rounded">@Model.Content</pre></dd>
    </dl>
</div>

<div class="modal-footer">
    <a asp-action="Edit" asp-route-id="@((int)Model.Id)" class="btn btn-warning btn-modal-action">Edit</a>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>
