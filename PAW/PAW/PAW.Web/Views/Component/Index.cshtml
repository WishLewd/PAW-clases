@model IEnumerable<PAW.Models.DTO.ComponentDTO>
@{
    ViewData["Title"] = "Components";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Components</h2>
        <a asp-action="Create" class="btn btn-primary btn-modal-action">
            <i class="bi bi-plus-circle"></i> Add Component
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Content</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td><strong>@item.Name</strong></td>
                                    <td>@item.Content</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@((int)item.Id)" class="btn btn-sm btn-warning btn-modal-action">Edit</a>
                                            <a asp-action="Details" asp-route-id="@((int)item.Id)" class="btn btn-sm btn-info btn-modal-action">Details</a>
                                            <a asp-action="Delete" asp-route-id="@((int)item.Id)" class="btn btn-sm btn-danger btn-modal-action">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">No components found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_Pagination", (PAW.Web.Models.PaginationModel)ViewBag.Pagination)
        </div>
    </div>
</div>
