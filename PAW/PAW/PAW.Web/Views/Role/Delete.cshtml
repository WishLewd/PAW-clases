@model PAW.Models.DTO.RoleDTO
@{
    ViewData["Title"] = "Delete Role";
}

<div class="container mt-4">
    <h2 class="text-danger">Delete Role</h2>
    <h4>Are you sure you want to delete this role?</h4>
    <hr />
    <div class="card shadow-sm col-md-8">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Role ID</dt>
                <dd class="col-sm-8">@Model.RoleId</dd>

                <dt class="col-sm-4">Role Name</dt>
                <dd class="col-sm-8">@Model.RoleName</dd>
            </dl>
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="RoleId" />
                <button type="submit" class="btn btn-danger">Confirm Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
