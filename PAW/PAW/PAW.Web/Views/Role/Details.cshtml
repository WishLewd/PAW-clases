@model PAW.Models.DTO.RoleDTO

<div class="modal-header bg-info text-white">
    <h5 class="modal-title">Role Details: @Model.RoleName</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <dl class="row mb-0">
        <dt class="col-sm-4">Role ID</dt>
        <dd class="col-sm-8">@Model.RoleId</dd>

        <dt class="col-sm-4">Role Name</dt>
        <dd class="col-sm-8">@Model.RoleName</dd>
    </dl>
</div>

<div class="modal-footer">
    <a asp-action="Edit" asp-route-id="@Model.RoleId" class="btn btn-warning btn-modal-action">Edit</a>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>
