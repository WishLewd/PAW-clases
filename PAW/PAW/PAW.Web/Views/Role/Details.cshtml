@model PAW.Models.DTO.RoleDTO
@{
    ViewData["Title"] = "Role Details";
}

<div class="container mt-4">
    <h2>Role Details</h2>
    <hr />
    <div class="card shadow-sm col-md-8">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Role ID</dt>
                <dd class="col-sm-8">@Model.RoleId</dd>

                <dt class="col-sm-4">Role Name</dt>
                <dd class="col-sm-8">@Model.RoleName</dd>
            </dl>
            <a asp-action="Edit" asp-route-id="@Model.RoleId" class="btn btn-warning">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>
