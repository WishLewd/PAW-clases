@model PAW.Models.DTO.UserDTO
@{
    ViewData["Title"] = "User Details";
}

<div class="container mt-4">
    <h2>User Details</h2>
    <hr />
    <div class="card shadow-sm col-md-8">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">User ID</dt>
                <dd class="col-sm-8">@Model.UserId</dd>

                <dt class="col-sm-4">Username</dt>
                <dd class="col-sm-8">@Model.Username</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Is Active</dt>
                <dd class="col-sm-8">@(Model.IsActive == true ? "Yes" : "No")</dd>

                <dt class="col-sm-4">Created At</dt>
                <dd class="col-sm-8">@Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>
            <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-warning">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>
