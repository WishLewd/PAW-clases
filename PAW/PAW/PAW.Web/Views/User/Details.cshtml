@model PAW.Models.DTO.UserDTO

<div class="modal-header bg-info text-white">
    <h5 class="modal-title">User Details: @Model.Username</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <dl class="row mb-0">
        <dt class="col-sm-4">User ID</dt>
        <dd class="col-sm-8">@Model.UserId</dd>

        <dt class="col-sm-4">Username</dt>
        <dd class="col-sm-8">@Model.Username</dd>

        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">@Model.Email</dd>

        <dt class="col-sm-4">Is Active</dt>
        <dd class="col-sm-8">@(Model.IsActive == true ? "Yes" : "No")</dd>

        <dt class="col-sm-4">Created At</dt>
        <dd class="col-sm-8">@Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>
</div>

<div class="modal-footer">
    <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-warning btn-modal-action">Edit</a>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>
